# --- Supabase ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key      # keep secret, backend only, bypasses RLS
SUPABASE_JWT_SECRET=your-jwt-secret                  # Project Settings -> API -> JWT Settings

# --- AI text providers (both have free tiers) ---
GEMINI_API_KEY=your-gemini-api-key                   # https://aistudio.google.com/app/apikey
GROQ_API_KEY=your-groq-api-key                       # https://console.groq.com/keys

# --- Video render worker (Colab/Kaggle notebook auth) ---
WORKER_API_KEY=choose-a-long-random-string           # must match the same value pasted into the notebook

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5500                # change to your live frontend URL when deployed
